meta {
  name: Create requisition
  type: http
  seq: 5
}

post {
  url: https://bankaccountdata.gocardless.com/api/v2/requisitions/
  body: json
  auth: none
}

headers {
  accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "redirect": "https://aalhub.uk/lander",
    "institution_id": "SANDBOXFINANCE_SFIN0000",
    "reference": "{{$randomUUID}}",
    "agreement": "{{user_agreement_id}}",
    "user_language": "EN"
  }
}

script:post-response {
  const body = res.getBody();
  
  let json;
  try {
    json = typeof body === 'string' ? JSON.parse(body) : body;
  } catch (e) {
    console.error('⚠️ failed to parse JSON:', e, body);
    return;
  }
  
  if (!json.id) {
    console.error('⚠️ no `id` field in response:', json);
  } else {
    bru.setVar('requisition_id', json.id);
  }
}
