meta {
  name: List accounts
  type: http
  seq: 6
}

get {
  url: https://bankaccountdata.gocardless.com/api/v2/requisitions/{{requisition_id}}/
  body: none
  auth: none
}

headers {
  accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const body = res.getBody();
  
  let json;
  try {
    json = typeof body === 'string' ? JSON.parse(body) : body;
  } catch (e) {
    console.error('⚠️ failed to parse JSON:', e, body);
    return;
  }
  
  if (!json.accounts) {
    console.error('⚠️ no `id` field in response:', json);
  } else {
    bru.setVar('account_id', json.accounts[0]);
  }
}
